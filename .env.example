# Grafana Monitoring Dashboard - Environment Configuration

# =============================================================================
# Grafana Instances Configuration
# =============================================================================
# Define your Grafana instances as a JSON array
# Format: [{"name": "Instance Name", "url": "https://grafana.example.com", "token": "your-api-token"}]
GRAFANA_INSTANCES=[{"name":"Production","url":"https://grafana.example.com","token":"your-grafana-api-token-here"}]

# =============================================================================
# Frontend Default Settings
# =============================================================================
# These settings define the initial default values for users who haven't
# saved any preferences yet. Once a user changes settings through the UI,
# their preferences are saved in browser cookies and override these defaults.

# View Mode
# Options: 'compact' or 'grid'
# Default: compact
DEFAULT_VIEW_MODE=compact

# Selected States Filter
# Comma-separated list of alert states to show by default
# Options: alerting, pending, no_data, paused, silenced, ok
# Default: all states shown
DEFAULT_SELECTED_STATES=alerting,pending,no_data,paused,silenced,ok

# Selected Instances Filter
# Comma-separated list of instance names to show by default
# Leave empty to show all instances
# Default: empty (all instances)
DEFAULT_SELECTED_INSTANCES=

# Selected Labels Filter
# Comma-separated list of labels to filter by default
# Leave empty to show all labels
# Default: empty (all labels)
DEFAULT_SELECTED_LABELS=

# Text Size
# Numeric value between 1 and 3
# Default: 2 (medium)
DEFAULT_FONT_SIZE=2

# Theme
# Options: 'light', 'system', or 'dark'
# Default: dark
DEFAULT_THEME=dark

# Show Normal Sub-alerts
# Show sub-alerts that are in 'Normal' state
# Options: 'true' or 'false'
# Default: false
DEFAULT_SHOW_NORMAL_SUBALERTS=false

# Highlight Duration
# Duration in seconds to highlight new/changed alerts (0 = off)
# Default: 10
DEFAULT_HIGHLIGHT_DURATION=10

# Notification Sound
# Sound file to play when alerts change state
# Options: notification-1.mp3, notification-2.mp3, notification-3.mp3, 
#          notification-4.mp3, notification-5.mp3, or empty for no sound
# Default: notification-1.mp3
DEFAULT_NOTIFICATION_SOUND=notification-1.mp3

# Notification Volume
# Volume level for notification sounds (0.0 to 1.0)
# Default: 0.5
DEFAULT_NOTIFICATION_VOLUME=0.5
